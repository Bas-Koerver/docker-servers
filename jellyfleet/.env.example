# =============================================================================
# Storage paths
# =============================================================================

# Directory used for application configuration and persistent data.
# Example: /opt/docker/appdata
APPDATA_LOCATION=

# Directory containing media files.
# Example: /mnt/media
DATA_LOCATION=

# Directory containing Docker secret files.
# Example: /opt/docker/secrets
SECRETS_LOCATION=


# =============================================================================
# PostgreSQL passwords
# =============================================================================

# PostgreSQL password used by Seerr.
SEERR_PG_PASS=

# PostgreSQL password used by Radarr.
RADARR_PG_PASS=

# PostgreSQL password used by Sonarr.
SONARR_PG_PASS=

# PostgreSQL password used by Lidarr.
LIDARR_PG_PASS=

# PostgreSQL password used by Prowlarr.
PROWLARR_PG_PASS=

# Secret filename containing the PostgreSQL password used by Autobrr.
AUTOBRR_PG_PASS_FILE=

# PostgreSQL password used by Bazarr.
BAZARR_PG_PASS=


# =============================================================================
# Autobrr OpenID Connect
# =============================================================================

# Secret filename containing the OIDC client ID.
AUTOBRR_OIDC_CLIENT_ID_FILE=

# Secret filename containing the OIDC client secret.
AUTOBRR_OIDC_CLIENT_SECRET_FILE=

# OIDC issuer URL.
# Example: https://auth.example.com/application/o/autobrr/
AUTOBRR_CONFIGURATION_ISSUER=

# OIDC callback URL configured with the identity provider.
# Example: https://autobrr.example.com/api/auth/oidc/callback
AUTOBRR_REDIRECT_URL=


# =============================================================================
# Qui OpenID Connect
# =============================================================================

# OIDC client ID.
QUI_OIDC_CLIENT_ID=

# Secret filename containing the OIDC client secret.
QUI_OIDC_CLIENT_SECRET_FILE=

# OIDC issuer URL.
# Example: https://auth.example.com/application/o/qui/
QUI_CONFIGURATION_ISSUER=

# OIDC callback URL configured with the identity provider.
# Replace the path below if Qui requires a different callback endpoint.
# Example: https://qui.example.com/api/auth/oidc/callback
QUI_REDIRECT_URL=
